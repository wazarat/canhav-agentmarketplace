{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canhav.com/schemas/market-map/universal.json",
  "title": "Universal project fields",
  "description": "Typed Postgres columns on the projects table. Every project across every sector has these.",
  "type": "object",
  "required": ["slug", "name", "sector_slug", "subsector_slug"],
  "additionalProperties": false,
  "properties": {
    "slug":                  { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$", "description": "Lowercase kebab-case unique identifier." },
    "name":                  { "type": "string", "minLength": 1 },
    "description":           { "type": ["string", "null"] },
    "website_url":           { "type": ["string", "null"], "format": "uri" },
    "logo_url":              { "type": ["string", "null"], "format": "uri" },
    "twitter_handle":        { "type": ["string", "null"], "description": "Bare handle, no @ and no URL." },
    "github_url":            { "type": ["string", "null"], "format": "uri" },
    "status":                { "type": ["string", "null"], "enum": ["live", "testnet", "mainnet", "archived", "unknown", null] },
    "stage":                 { "type": ["string", "null"], "enum": ["idea", "pre-seed", "seed", "series-a", "series-b", "series-c-plus", "profitable", "acquired", "shutdown", "unknown", null] },
    "founded_year":          { "type": ["integer", "null"], "minimum": 1980, "maximum": 2100 },
    "hq_country":            { "type": ["string", "null"], "description": "ISO-3166 alpha-2 code preferred (e.g. 'US', 'SG'). Free text accepted." },
    "team_size_range":       { "type": ["string", "null"], "enum": ["1-10", "11-50", "51-200", "201-500", "500+", "unknown", null] },
    "total_funding_usd":     { "type": ["integer", "null"], "minimum": 0 },
    "last_funding_round":    { "type": ["string", "null"] },
    "last_funding_date":     { "type": ["string", "null"], "format": "date" },
    "sector_slug":           { "type": "string" },
    "subsector_slug":        { "type": "string" }
  }
}
