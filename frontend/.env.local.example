NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-only fallback used by the Market Map server components. Defaults to NEXT_PUBLIC_API_BASE_URL
# if unset. Useful if you ever want a different internal base URL for SSR fetches.
# API_BASE_URL=http://localhost:8000

# PostHog (Product Analytics + Web Analytics)
# Project token from us.posthog.com/project/<id>/settings/project-details
# Leave blank locally to disable analytics in dev.
NEXT_PUBLIC_POSTHOG_KEY=
# US Cloud (default). Use https://eu.posthog.com if your project is on EU.
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
